# envs/.envs.e2e.template

# Template for End-to-End (E2E) Local Test Environment Variables for Radar-Core, Postgres and Metabase
#   running together in Docker containers

# --- POSTGRESQL CONTAINER SETTINGS ---
# These variables configure the DB container via 00-init-dbs.sh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=set_your_e2e_local_password
POSTGRES_DB=postgres
# Custom variable for 00-init-dbs.sh script
POSTGRES_MULTIPLE_DATABASES=radar,metabase
# Optional
POSTGRES_SSL_MODE=prefer
POSTGRES_OPTIONS='-c search_path%3Dpublic'
# Expose PostgreSQL on a different port to avoid conflicts with Windows's PostgreSQL host
POSTGRES_EXTERNAL_PORT=5433

# --- RADAR-CORE SETTINGS (Container connecting to sibling container) ---
# Connection using the internal Docker network service name
POSTGRES_HOST=db
POSTGRES_PORT=5432
# The app will connect to the 'radar' database created by initialization scripts
POSTGRES_DB_NAME=radar
# App environment: dev, e2e, prod
RADAR_ENV=e2e
# YML configuration file: create it in the same folder where is `settings.py` or set the absolute path to the file
# e.g. for Docker container: `settings.yml` if next to `settings.py`, or `/home/default/app/settings.yml`
RADAR_SETTING_FILE=settings.yml
# If true, the ratios for symbols not listed in `settings.yml` will be cleaned from the DB at the start of the `analyzer.py`
RADAR_CLEAN_UNLISTED=false

# --- RADAR-CORE LOGGING SETTINGS ---
# Disable file logging for containerization environments
RADAR_ENABLE_FILE_LOGGING=false
# Log levels: 10.Debug, 20.Info, 30.Warning, 40.Error, 50.Critical
RADAR_LOG_LEVEL=20

# --- RADAR-CORE PERFORMANCE SETTINGS ---
# Number of parallel workers for the analyzer.
# Set to a positive integer (recommended), 0 or leave unset to use all available cores.
RADAR_MAX_WORKERS=2

# --- RADAR-CORE PRICE CACHE SETTINGS ---
# Directory where normalized daily OHLCV Parquet cache and metadata are persisted.
# For Docker containers, use a mounted persistent directory (e.g. /home/default/app/cache).
RADAR_PRICE_CACHE_DIR=/home/default/app/cache
# Enable or disable reading/using local price cache. Set to true to enable.
RADAR_PRICE_CACHE_ENABLED=true
# If true, bypasses reading existing cache data and forces a complete download from Yahoo Finance.
RADAR_PRICE_CACHE_IGNORE=false
# If true, writes complete or refreshed cache to disk after successful downloads.
RADAR_PRICE_CACHE_WRITE=true
# Timezone used for evaluating the production market session window (IANA timezone name).
RADAR_PRICE_CACHE_TIMEZONE=America/New_York
# Production market window start time (HH:MM). During this window on weekdays, eligible caches trigger current-day refresh.
RADAR_PRICE_CACHE_WINDOW_START=09:30
# Production market window end time (HH:MM), extended past market close to allow post-session execution.
RADAR_PRICE_CACHE_WINDOW_END=17:00
# Maximum cache age in minutes allowed for automatic reuse when RADAR_ENV=dev outside the production window.
RADAR_PRICE_CACHE_DEV_MAX_AGE_MINUTES=10

# --- METABASE SETTINGS (Container connecting to sibling container) ---
# Metabase connects to the same 'db' service but to its own database
MB_DB_TYPE=postgres
MB_DB_HOST=db
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
# Expose Metabase UI on a different port to avoid conflicts with Metabase running on radar-core project configuration
#   (radar-core/docker/docker-compose.mb.yml)
METABASE_UI_PORT=3001
